

# 1. Update System
echo "Updating system packages..."
sudo dnf update -y

# 2. Install Dependencies
echo "Installing necessary dependencies..."
sudo dnf install -y ca-certificates curl

# 3. Configure Kernel Modules (Master & Worker Node)
echo "Configuring kernel modules for containerd..."
cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF

sudo modprobe br_netfilter
sudo modprobe overlay

# 4. Configure Networking (Master & Worker Node)
echo "Configuring system parameters for Kubernetes networking..."
cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sudo sysctl --system

# 5. Install containerd (Master & Worker Node)
echo "Installing containerd..."
sudo dnf install -y containerd

# 6. Modify containerd Configuration (Master & Worker Node)
echo "Configuring containerd..."
sudo mkdir -p /etc/containerd
sudo containerd config default | sudo tee /etc/containerd/config.toml
sudo sed -i 's/SystemdCgroup \= false/SystemdCgroup \= true/g' /etc/containerd/config.toml

# Restart containerd service
sudo systemctl restart containerd.service
sudo systemctl status containerd

# 7. Install Kubernetes Tools (kubelet, kubeadm, kubectl)
echo "Installing Kubernetes management tools (kubelet, kubeadm, kubectl)..."
curl -fsSL https://packages.cloud.google.com/yum/doc/yum-key.gpg | sudo tee /etc/yum.repos.d/kubernetes.repo

# Install Kubernetes tools
sudo dnf install -y kubelet kubeadm kubectl

# Mark packages to prevent accidental upgrades
sudo dnf mark hold kubelet kubeadm kubectl

# 8. Initialize Kubernetes Cluster (Master Node)
echo "Initializing Kubernetes cluster (Run this on the Master Node only)..."
sudo kubeadm init --apiserver-advertise-address=172.17.18.200 --pod-network-cidr=192.168.0.0/16 --cri-socket /run/containerd/containerd.sock --ignore-preflight-errors Swap

# 9. Configure kubectl (Master Node)
echo "Configuring kubectl on Master Node..."
mkdir -p $HOME/.kube
sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
sudo chown $(id -u):$(id -g) $HOME/.kube/config

# 10. Install Calico Networking (Master Node)
echo "Installing Calico networking..."
kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.29.3/manifests/tigera-operator.yaml
curl https://raw.githubusercontent.com/projectcalico/calico/v3.29.3/manifests/custom-resources.yaml -O
kubectl create -f custom-resources.yaml

# 11. Print Join Command for Worker Nodes (Master Node)
echo "Generating join token for Worker Nodes..."
kubeadm token create --print-join-command

# 12. Join Worker Nodes to the Cluster (Run this on Worker Nodes)
# This command should be executed on each Worker Node (you'll get this token from the previous step)
echo "Run the following command on Worker Node(s) to join the cluster:"
echo "kubeadm join 172.17.18.200:6443 --token <your-token> --discovery-token-ca-cert-hash sha256:<hash>"

# 13. Get Cluster Info (Master Node)
echo "Getting cluster info..."
kubectl cluster-info
kubectl cluster-info dump

# 14. Deploy Applications (Master Node)
echo "Deploying Nginx as an example application..."
kubectl run nginx-deployment --image=nginx --replicas=3 --port=80
kubectl expose deployment nginx-deployment --type=LoadBalancer --name=nginx-service

# 15. Check Pods and Services (Master Node)
echo "Checking the deployed pods and services..."
kubectl get pods
kubectl get services

echo "Kubernetes cluster setup complete!"
